{
  "name": "devatlas",
  "version": "2.0.0",
  "private": true,
  "description": "DevAtlas: a developer newspaper printed twice a day by GitHub Actions",
  "workspaces": [
    "pipeline",
    "frontend"
  ],
  "scripts": {
    "print": "npm run print --workspace=@devatlas/pipeline",
    "dev": "npm run dev --workspace=@devatlas/frontend",
    "build": "npm run build --workspace=@devatlas/frontend",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "license": "MIT"
}
