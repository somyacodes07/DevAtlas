{
  "name": "@devatlas/pipeline",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Scrapes the open web and writes each edition of the paper to data/",
  "scripts": {
    "print": "node --env-file-if-exists=../.env --import tsx src/index.ts",
    "print:dry": "node --env-file-if-exists=../.env --import tsx src/index.ts --dry",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
