# Cloudflare Pages response headers.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  X-Frame-Options: DENY

# Fingerprinted build output never changes, so browsers may keep it for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Link-preview cards and icons are written without a file extension; say what they are.
/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=3600
/*/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=3600
/edition/*/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=86400
/apple-icon
  Content-Type: image/png
  Cache-Control: public, max-age=86400
/icons/*
  Cache-Control: public, max-age=86400

/feed.xml
  Content-Type: application/rss+xml; charset=utf-8
  Cache-Control: public, max-age=600
