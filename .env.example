# ==============================================================================
# DevAtlas - Environment Configuration
# Copy this file to .env or set these in GitHub Actions / Cloudflare Secrets.
# NEVER commit real credentials to version control.
# ==============================================================================

# Node Environment
NODE_ENV=development

# ------------------------------------------------------------------------------
# MongoDB Configuration (MongoDB Atlas Free Tier / Local MongoDB)
# ------------------------------------------------------------------------------
# Local dev: mongodb://localhost:27017/devatlas
# Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/devatlas?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/devatlas
MONGODB_DATABASE=devatlas

# ------------------------------------------------------------------------------
# Worker / API Configuration
# ------------------------------------------------------------------------------
PORT=8787
WORKER_ENV=development
API_BASE_URL=http://localhost:8787
ADMIN_API_KEY=devatlas-local-admin-key-change-in-production

# ------------------------------------------------------------------------------
# Frontend Configuration (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8787/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Discovery & Source Adapters
# ------------------------------------------------------------------------------
# Optional GitHub Personal Access Token for higher rate limits (5,000 req/hr vs 60 req/hr)
GITHUB_TOKEN=

# ------------------------------------------------------------------------------
# AI Provider Configuration
# Options: "mock" (default, zero cost) | "deterministic" | "ollama" | "openai"
# ------------------------------------------------------------------------------
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
AI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# Cloudflare Credentials (Only required for CI/CD deploy workflows)
# ------------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_KV_NAMESPACE_ID=
