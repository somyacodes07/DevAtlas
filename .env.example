# Everything here is optional. The paper prints with no keys at all.

# Raises the GitHub API rate limit for local runs (Actions provides its own).
GITHUB_TOKEN=

# Let a free-tier model write the briefing. Groq is used if both are set.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Time zone that decides the date and morning/evening of an edition.
EDITION_TZ=Asia/Kolkata

# Public address of the site, used for the sitemap and link previews.
NEXT_PUBLIC_SITE_URL=https://devatlas.pages.dev

# API the site calls, and the token the publish step uses to send an edition to it.
NEXT_PUBLIC_API_URL=http://localhost:8787/api/v1
API_URL=http://localhost:8787/api/v1
ADMIN_TOKEN=dev-token
